<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nill Wrap-Up</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <header class="site-header">
        <div class="site-header__inner">
            <a class="site-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span>NILL FORUM</span>
                <span class="site-brand__divider" aria-hidden="true">/</span>
                <span>WRAP-UP</span>
            </a>
            <nav class="site-nav" aria-label="Navigazione principale">
                <a href="/Account/Login">Accedi</a>
            </nav>
        </div>
    </header>

    <main class="site-main" id="contenuto">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <span>Un riepilogo personale per la community del Nill Forum.</span>
            <a href="https://nill.forumcommunity.net/">Vai al Nill Forum</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
